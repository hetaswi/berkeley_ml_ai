        "\n",
        "# --- Targeted Segment Metric Calculation ---\n",
        "coffee_df = df[df['coupon'] == 'Coffee House'].copy()\n",
        "coffee_df['CoffeeHouse'] = coffee_df['CoffeeHouse'].fillna(coffee_df['CoffeeHouse'].mode()[0])\n",
        "\n",
        "frequent_visitor = coffee_df['CoffeeHouse'].isin(['1~3', '4~8', 'gt8'])\n",
        "prime_time = coffee_df['time'].isin(['10AM', '2PM'])\n",
        "social_passengers = coffee_df['passanger'].isin(['Friend(s)', 'Partner'])\n",
        "\n",
        "target_segment = frequent_visitor & (prime_time | social_passengers)\n",
        "\n",
        "print(f\"Target Segment Acceptance Rate: {coffee_df[target_segment]['Y'].mean():.2%}\")\n",
        "print(f\"Non-Target Acceptance Rate:    {coffee_df[~target_segment]['Y'].mean():.2%}\")"
