      "source": [
        "# 1. Drop non-informative or redundant columns\n",
        "df_clean = df.drop(columns=['car', 'toCoupon_GEQ5min', 'direction_opp']).copy()\n",
        "\n",
        "# 2. Fix typos in column names\n",
        "df_clean = df_clean.rename(columns={'passanger': 'passenger'})\n",
        "\n",
        "# 3. Remove duplicate rows\n",
        "df_clean = df_clean.drop_duplicates()\n",
        "\n",
        "# 4. Impute missing venue visit frequencies with mode (Warning-Free Syntax)\n",
        "frequency_cols = ['Bar', 'CoffeeHouse', 'CarryAway', 'RestaurantLessThan20', 'Restaurant20To50']\n",
