            "All Others:\n",
            "  Count: 1597, Accepted: 535, Rate: 0.3350 (33.50%)\n",
            "\n",
            "Difference: 36.02 percentage points\n"
          ]
        }
      ],
      "source": [
        "bar_df = df[df['coupon'] == 'Bar'].copy()\n",
        "\n",
        "# Print unique values of age to see how it's formatted\n",
        "print(\"Unique age values:\")\n",
        "print(bar_df['age'].unique())\n",
        "\n",
        "# 'more than once a month': Bar in ['1~3', '4~8', 'gt8']\n",
        "# 'over the age of 25': age NOT in ['below21', '21'] -> i.e., '26', '31', '36', '41', '46', '50plus'\n",
        "\n",
        "bar_gt1 = bar_df['Bar'].isin(['1~3', '4~8', 'gt8'])\n",
        "age_gt25 = ~bar_df['age'].isin(['below21', '21'])\n",
        "\n",
        "target_group_mask = bar_gt1 & age_gt25\n",
        "\n",
        "rate_target = bar_df[target_group_mask]['Y'].mean()\n",
        "count_target = len(bar_df[target_group_mask])\n",
        "accepted_target = bar_df[target_group_mask]['Y'].sum()\n",
        "\n",
        "rate_others = bar_df[~target_group_mask]['Y'].mean()\n",
        "count_others = len(bar_df[~target_group_mask])\n",
        "accepted_others = bar_df[~target_group_mask]['Y'].sum()\n",
        "\n",
        "print(f\"\\nTarget Group (Bar > 1 time/month AND Age > 25):\")\n",
        "print(f\"  Count: {count_target}, Accepted: {accepted_target}, Rate: {rate_target:.4f} ({rate_target*100:.2f}%)\")\n",
        "\n",
        "print(f\"\\nAll Others:\")\n",
        "print(f\"  Count: {count_others}, Accepted: {accepted_others}, Rate: {rate_others:.4f} ({rate_others*100:.2f}%)\")\n",
        "\n",
        "diff = rate_target - rate_others\n",
        "print(f\"\\nDifference: {diff*100:.2f} percentage points\")"
      ]
    },
