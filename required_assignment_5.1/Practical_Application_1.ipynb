      "source": [
        "bar_df = df[df['coupon'] == 'Bar'].copy()\n",
        "\n",
        "# Value counts of the 'Bar' column in bar_df to see exact category names\n",
        "print(\"Unique values in Bar column:\")\n",
        "print(bar_df['Bar'].value_counts(dropna=False))\n",
        "\n",
        "# Categorize: <= 3 times a month vs > 3 times a month\n",
        "# 'never', 'less1', '1~3' -> <= 3 times\n",
        "# '4~8', 'gt8' -> > 3 times\n",
        "\n",
        "bar_df['bar_gt3'] = bar_df['Bar'].isin(['4~8', 'gt8'])\n",
        "\n",
        "# Calculate acceptance rates\n",
        "comparison = bar_df.groupby('bar_gt3')['Y'].agg(\n",
        "    Total_Count='count',\n",
        "    Accepted_Count='sum',\n",
        "    Acceptance_Rate='mean'\n",
        ").reset_index()\n",
        "\n",
        "comparison['Category'] = comparison['bar_gt3'].map({False: '3 or fewer times / month', True: 'More than 3 times / month'})\n",
        "comparison['Acceptance_Rate_Pct'] = comparison['Acceptance_Rate'] * 100\n",
        "\n",
        "print(\"\\nComparison Summary:\")\n",
        "print(comparison[['Category', 'Total_Count', 'Accepted_Count', 'Acceptance_Rate_Pct']])"
      ]
