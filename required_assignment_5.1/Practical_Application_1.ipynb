        "# Plot 3: Acceptance Rate by Passenger Type\n",
        "pass_acc = coffee_df.groupby('passanger')['Y'].mean().reset_index().sort_values(by='Y', ascending=False)\n",
        "ax3 = sns.barplot(data=pass_acc, x='passanger', y='Y', hue='passanger', ax=axes[1, 0], palette='Greens_d')\n",
        "axes[1, 0].set_title('3. Acceptance Rate by Passenger Type', fontsize=12, fontweight='bold')\n",
